{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lake: build",
      "detail": "build lean files",
      "type": "shell",
      "command": "lake build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
    {
      "label": "game: open browser",
      "command": "${input:openSimpleBrowser}",
      "problemMatcher": [],
      // "runOptions": {
      //   "runOn": "folderOpen"
      // }
    },
    {
      "label": "game: start server",
      "detail": "manually (re)start the lean4game client + relay (already runs automatically on Codespace start via postStartCommand)",
      "type": "shell",
      "command": "bash .devcontainer/run-server.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
    },
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://localhost:3000"]
    }
  ]
}
