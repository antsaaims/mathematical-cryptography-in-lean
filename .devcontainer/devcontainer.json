{
  "name": "Lean 4 & Mathlib Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ]
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": "lake exe cache get",
  "remoteUser": "vscode"
}
